# OPC Brain Docker deployment template.
# Copy this file to `.env`, optionally fill the API key, then run:
#   ./scripts/docker-up.sh

# Host port exposed by Docker. Visit http://localhost:3001 by default.
OPCBRAIN_WEB_PORT=3001

# Persisted host workspace mounted into the container at /workspace.
# Use an absolute path in production, for example:
# OPCBRAIN_WORKSPACE=/data/opcbrain-workspace
OPCBRAIN_WORKSPACE=./workspace

# Login is disabled by default for local/private deployments.
# Set to 0 to require username/password auth.
OPCBRAIN_DISABLE_LOCAL_AUTH=true

# Default OpenAI-compatible provider config.
# Examples:
#   OpenRouter: openrouter/deepseek/deepseek-v4-flash + https://openrouter.ai/api/v1
#   DeepSeek:   deepseek/deepseek-v4-flash + https://api.deepseek.com/v1
#   Moonshot:   moonshot/kimi-k2.6 + https://api.moonshot.cn/v1
OPCBRAIN_MODEL=openrouter/deepseek/deepseek-v4-flash
OPCBRAIN_LIGHT_MODEL=openrouter/qwen/qwen3-8b
OPCBRAIN_API_URL=https://openrouter.ai/api/v1
# You can either fill this now, or keep the placeholder and finish setup in the Web UI.
OPCBRAIN_API_KEY=PLACEHOLDER_RUN_ONBOARDING_TO_REPLACE

# Optional: use another key/base URL for the lightweight routing model.
OPCBRAIN_LIGHT_API_URL=
OPCBRAIN_LIGHT_API_KEY=

# Optional HTTP proxy, for example http://host.docker.internal:7890
OPCBRAIN_PROXY=
